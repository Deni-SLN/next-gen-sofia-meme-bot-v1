# Secrets. `.env.example` IS committed; a real `.env` never is.
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.coverage
htmlcov/

# Node
node_modules/
npm-debug.log*
.vite/

# Build output. Regenerated by `npm run build`; committing it only creates
# merge conflicts on every style change.
apps/web/dist/

# Local databases. These hold whatever this machine happened to run, including
# wallet addresses and audit rows. Alembic owns the schema, not the data.
data/*.db
data/*.db-journal
data/*.sqlite
data/*.sqlite3

# Runtime artefacts
*.log
*.pid
heartbeat
*.heartbeat

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Keep the data directory itself: the app creates the directory but a fresh
# checkout should not have to.
!data/.gitkeep