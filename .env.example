# Next Gent Sofia Trade v1 - Environment Configuration
# Copy to .env and adjust. NEVER commit real secrets.

# --- Core ---
SOFIA_ENV=development
SOFIA_DATABASE_URL=sqlite:///./data/sofia_trade.db
# For Docker/PostgreSQL:
# SOFIA_DATABASE_URL=postgresql+psycopg://sofia:sofia@localhost:5432/sofia_trade

# --- Database migrations (Alembic owns the schema) ---
#   alembic upgrade head      apply migrations
#   alembic downgrade -1      roll back one revision
#   alembic revision --autogenerate -m "..."   after changing models
# Outside development the API refuses to start if the schema is not at head.

# --- Auth (single-user V1) ---
# Auth is ON by default. Only set AUTH_DISABLED=true for local dev; the server
# REFUSES TO BOOT if it is true outside development/test/local.
SOFIA_AUTH_DISABLED=false
# Preferred: a PBKDF2-HMAC-SHA256 hash. Generate with:
#   python -m app.cli.hash_password 'your-password'
SOFIA_ADMIN_PASSWORD_HASH=
# Legacy plaintext fallback. Ignored when the hash above is set.
SOFIA_ADMIN_PASSWORD=change-me-in-production
# Optional read-only observer (PRD 3.2). Leave empty to disable observer login.
SOFIA_OBSERVER_PASSWORD_HASH=
SOFIA_OBSERVER_PASSWORD=
# Session lifetime in seconds (default 8h).
SOFIA_SESSION_TTL_SECONDS=28800
# Secret for internal signal HMAC. Empty disables internal signing.
SOFIA_INTERNAL_SIGNATURE_KEY=

# --- CORS ---
SOFIA_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Feature gates ---
# LIVE trading is disabled by default and must NEVER be enabled for V1 release.
SOFIA_LIVE_TRADING_ENABLED=false

# --- Market data: DEX Screener ---
SOFIA_DEXSCREENER_BASE_URL=https://api.dexscreener.com
SOFIA_DEXSCREENER_RATE_LIMIT_PER_MIN=60
# Per-endpoint budgets; the search and token endpoints are throttled separately
# so a burst on one cannot exhaust the other.
SOFIA_DEXSCREENER_SEARCH_RATE_LIMIT_PER_MIN=60
SOFIA_DEXSCREENER_TOKENS_RATE_LIMIT_PER_MIN=60
SOFIA_MARKET_CACHE_TTL_SECONDS=30

# --- Scanner filters (discovery thresholds, FR-AE-001) ---
# A pair is dropped when a threshold is unmet. Incomplete data is excluded
# unless SOFIA_SCANNER_ALLOW_INCOMPLETE=true (not recommended: unknown is not zero).
SOFIA_SCANNER_MIN_LIQUIDITY_USD=10000
SOFIA_SCANNER_MIN_POOL_AGE_MINUTES=60
SOFIA_SCANNER_MIN_VOLUME_24H_USD=0
SOFIA_SCANNER_MIN_TXNS_1H=0
SOFIA_SCANNER_MIN_ABS_PRICE_CHANGE_1H_PCT=0
SOFIA_SCANNER_ALLOW_INCOMPLETE=false
SOFIA_SCANNER_MAX_RESULTS=40

# --- Solana RPC ---
SOFIA_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOFIA_SOLANA_RPC_RATE_LIMIT_PER_MIN=120

# --- AI providers ---
# 9Router (OpenAI-compatible)
SOFIA_NINROUTER_BASE_URL=https://9router.com/v1
SOFIA_NINROUTER_API_KEY=
SOFIA_NINROUTER_MODEL=

# OpenRouter (default: free router model)
SOFIA_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SOFIA_OPENROUTER_API_KEY=
SOFIA_OPENROUTER_DEFAULT_MODEL=openrouter/free

# Cross-provider fallback is OFF by default. When enabled, the order below is
# used and every candidate still passes the provider's own free-only gate.
SOFIA_LLM_CROSS_PROVIDER_FALLBACK=false
SOFIA_LLM_PROVIDER_ORDER=openrouter,9router
SOFIA_LLM_TIMEOUT_SECONDS=30

# --- Telegram alerts (optional) ---
SOFIA_TELEGRAM_BOT_TOKEN=
SOFIA_TELEGRAM_CHAT_ID=

# --- Worker intervals (seconds) ---
SOFIA_WORKER_SCANNER_INTERVAL=60
SOFIA_WORKER_ANALYSIS_INTERVAL=120
SOFIA_WORKER_SIGNAL_EVAL_INTERVAL=60

# --- Accounting ---
SOFIA_INITIAL_PAPER_CAPITAL=1000
SOFIA_IDR_RATE=16300

# --- Docker Compose (Phase 7) ---
# Read by docker-compose.yml. POSTGRES_PASSWORD is REQUIRED (compose refuses to
# start without it).
#   docker compose up -d --build
POSTGRES_USER=sofia
POSTGRES_PASSWORD=
POSTGRES_DB=sofia
API_PORT=8000
WEB_PORT=3000
