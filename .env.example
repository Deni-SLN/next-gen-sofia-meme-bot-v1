# NextGenTSofia Trade - Environment Configuration
# Copy this file to .env and update the values

# Application
SOFIA_APP_NAME=NextGenTSofia Trade
SOFIA_DEBUG=false

# Database (SQLite default, or use PostgreSQL)
SOFIA_DATABASE_URL=sqlite:///./sofia_trade.db

# Authentication
SOFIA_PRIMARY_USERNAME=operator
SOFIA_PRIMARY_PASSWORD=strongpasswordhere
SOFIA_ADMIN_PASSWORD=changeme
SOFIA_JWT_SECRET=sofia-super-secret-key-change-in-production-12345
SOFIA_JWT_EXPIRE_MINUTES=1440

# Solana On-Chain Trading Keypair
SOFIA_SOLANA_PRIVATE_KEY=

# AI / LLM Provider (OpenRouter)
SOFIA_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SOFIA_OPENROUTER_API_KEY=sk-or-v1-your-key-here
SOFIA_OPENROUTER_DEFAULT_MODEL=anthropic/claude-3.5-sonnet
SOFIA_LLM_TIMEOUT_SECONDS=30

# CORS
SOFIA_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
